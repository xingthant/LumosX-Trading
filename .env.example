# Copy this file to ".env" in the project root before running docker compose.
# ".env" is gitignored — never commit real secrets.

# Postgres
POSTGRES_USER=crypto_admin
POSTGRES_PASSWORD=replace_with_a_strong_random_password
POSTGRES_DB=crypto_platform

# Backend auth
JWT_SECRET=replace_with_a_long_random_string

# CORS — set to your real frontend origin in production, e.g. https://trade.example.com
CORS_ORIGIN=*

# Host port for the frontend container — change if 3000 is already taken on your server
FRONTEND_PORT=3000

# Public URLs the frontend is built with (baked in at build time — see DEPLOYMENT.md).
# For a VPS deployment, set these to the server's public IP or domain, e.g.:
#   NEXT_PUBLIC_API_URL=http://203.0.113.10:4000
#   NEXT_PUBLIC_WS_URL=http://203.0.113.10:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
